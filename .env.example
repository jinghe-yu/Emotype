# Copy to .env for local development. Keep actual credentials out of Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30
LLM_ENABLED=true
BODY_ADVICE_LLM_ENABLED=true
# Set a stable secret on the deployment host; do not use a sample secret.
SECRET_KEY=
